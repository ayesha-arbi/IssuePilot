# GitHub Token (required for repo analysis & free GitHub Models inference)
GITHUB_TOKEN=ghp_your personal access token here

# AI Model Provider Keys (optional — at least one recommended for brief generation)
# Google Gemini (may fail with HTTP 400 since Google deprecated unrestricted keys mid-2026)
#   Use Groq or OpenRouter instead if Gemini gives HTTP 400
GEMINI_API_KEY=your google ai studio key here

# Groq (free and reliable at console.groq.com)
GROQ_API_KEY=your groq api key here

# OpenRouter (free tier at openrouter.ai)
OPENROUTER_API_KEY=your openrouter key here

# Cerebras (optional)
CEREBRAS_API_KEY=your cerebras key here

# Together (optional)
TOGETHER_API_KEY=your together key here

# DeepSeek (optional)
DEEPSEEK_API_KEY=your deepseek key here

# Mistral (optional)
MISTRAL_API_KEY=your mistral key here

# Optional: Custom LLM configuration
# LLM_API_KEY=your custom key (for "custom" provider)
# LLM_BASE_URL=http://localhost:11434/v1 (for local Ollama)
# MODEL_FALLBACKS=groq/gpt-4o-mini,openrouter/meta-llama/llama-3.3-70b-instruct:free